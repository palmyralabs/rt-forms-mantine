{
  "name": "@palmyralabs/rt-forms-mantine",
  "private": false,
  "version": "0.3.0",
  "description": "Mantine UI bindings for Palmyra rt-forms: form fields, grid and menu components",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/palmyralabs/rt-forms-mantine.git"
  },
  "keywords": [
    "palmyra",
    "react",
    "mantine",
    "forms",
    "grid"
  ],
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --p ./build.tsconfig.json && vitest run && vite --config vite.config.ts build",
    "compile": "tsc --p ./demo.tsconfig.json && tsc --p ./build.tsconfig.json",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "test": "tsc --p ./test.tsconfig.json && vitest ",
    "demoBuild": "tsc --p ./demo.tsconfig.json",
    "testScript": "vitest --root test/"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react-swc": "^4.2.0",
    "glob": "^11.0.3",
    "jsdom": "^27.0.1",
    "react-icons": "^5.5.0",
    "serve-static": "^2.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "usehooks-ts": "^3.1.1",
    "vite": "^7.1.12",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^4.0.3"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "@mantine/core": "^9.1.1",
    "@mantine/dates": "^9.1.1",
    "@mantine/hooks": "^9.1.1",
    "@palmyralabs/palmyra-wire": "^1.2.0",
    "@palmyralabs/rt-forms": "^0.3.0",
    "@palmyralabs/ts-predicates": "^0.3.0",
    "@palmyralabs/ts-utils": "^0.3.0",
    "@tanstack/react-table": "^8.21.3",
    "dayjs": "^1.11.18",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "overrides": {
    "glob": "^11.0.3",
    "react": "^19.2.0"
  }
}
